{
  "name": "museum-almost-guestbook",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "SITE_ORIGIN": "https://example.github.io"
  },
  "ratelimits": [
    {
      "name": "HIT_RATE_LIMITER",
      "namespace_id": "930000001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "SIGN_RATE_LIMITER",
      "namespace_id": "930000002",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "museum-almost-guestbook",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ]
}
