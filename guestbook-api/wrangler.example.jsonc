{
  "name": "museum-almost-guestbook",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "SITE_ORIGIN": "https://example.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "museum-almost-guestbook",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ]
}
